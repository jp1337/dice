#!/usr/bin/env bash
# Blocks commits that contain secrets or personal data. Activated by `npm install` (prepare script).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"

email="$(git config user.email || true)"
if [[ "$email" != *@users.noreply.github.com ]]; then
  echo "pre-commit: commit author e-mail must be the GitHub noreply address." >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks is not installed, refusing to commit without a secret scan." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner "$root"

"$root/scripts/scan-personal-data.sh" staged
