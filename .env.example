# Copy to .env and fill in. Never commit .env.

NODE_ENV=production

# Public address of the app, without a trailing slash.
# Register ${BASE_URL}/auth/callback as redirect URL in the Discord Developer Portal.
BASE_URL=https://dice.example.org

# Host port on 127.0.0.1 that the reverse proxy forwards to. Inside the container the app always uses 3000.
PORT=3000

# Database password, used by docker compose for both containers.
# Use URL-safe characters only, e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Only needed without docker compose; compose builds it from POSTGRES_PASSWORD.
DATABASE_URL=postgres://dice:change-me@localhost:5432/dice

# Signs session cookies. At least 32 characters; generate one with: openssl rand -base64 48
SESSION_SECRET=

# Discord application (Developer Portal > OAuth2).
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=change-me

# Required: only members of this Discord server may log in.
DISCORD_GUILD_ID=000000000000000000

# Discord user IDs of the hosts, comma-separated.
HOST_DISCORD_IDS=000000000000000000,000000000000000001

# Addresses or networks whose X-Forwarded-* headers are trusted, comma-separated.
# Must be the address nginx connects from. nginx runs on the host, so the app sees the
# gateway of the compose network: 172.31.250.1 (see networks in docker-compose.yml).
TRUSTED_PROXIES=172.31.250.1

# Optional: subnet of the compose network, if 172.31.250.0/24 is taken. Change TRUSTED_PROXIES to its .1 address.
# DICE_SUBNET=172.31.250.0/24

# Imprint and privacy notice. Required in production.
LEGAL_NAME=Jane Doe
# Address lines separated by |
LEGAL_ADDRESS=Example Street 1|12345 Example Town
LEGAL_EMAIL=dice@example.org
# Optional extra line for the imprint.
LEGAL_NOTE=

# Days after the last activity before rooms, events and inactive users are deleted.
RETENTION_DAYS=90
